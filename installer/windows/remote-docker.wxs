<?xml version="1.0" encoding="utf-8"?>
<!--
  The Windows installer. Built on Windows by WiX v5; see build.ps1 beside this
  file and docs/adr/0048-a-windows-installer.md, which carries the reasoning
  for everything below.

  Two preprocessor variables, both required: BinPath (the remote-docker.exe to
  package) and Version (major.minor.build, validated by build.ps1).

  One package for two contexts (ADR 0048, 2026-10-28): for all users as an
  administrator, as before, or for one user with no administrator rights.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!--
    THE UpgradeCode MUST NEVER CHANGE. It is the only thing that relates one
    release's MSI to the next: change it and every future upgrade silently
    stops being an upgrade, leaving two installs side by side, two entries in
    Programs and Features, and two copies on PATH.
  -->
  <Package Name="remote-docker"
           Manufacturer="lhns"
           Version="$(Version)"
           UpgradeCode="6FDE5FD9-D1A3-4094-B8EC-2193CA79C91F"
           Scope="perUser"
           Language="1033"
           Compressed="yes"
           InstallerVersion="500">

    <SummaryInformation Description="Docker from a machine that cannot have Docker installed" />

    <!--
      WiX 5 has no perMachineOrUser scope, so it is written out: Scope="perUser"
      is the summary's "elevation not required" bit and no ALLUSERS, and
      ALLUSERS=2 makes the context a per-install choice. MSIINSTALLPERUSER=1
      is per user, empty is per machine. ALLUSERS=2 alone resolves to per
      machine, which a user without administrator rights is refused with 1925.
    -->
    <Property Id="ALLUSERS" Value="2" />

    <!-- Without this AdminUser can be true for a user who is not a real administrator, and NOT AdminUser below would never fire. -->
    <Property Id="MSIUSEREALADMINDETECTION" Value="1" />

    <!--
      Which context an install gets when nobody said, for an install with a user
      interface: without administrator rights a per-machine install is
      impossible, so that user gets their own copy. An administrator keeps the
      per-machine default, which is what finds the product that older releases
      installed. Only the client-side sequence can do this. A silent install
      resolves its context before any sequence runs (measured: a standard user's
      /qn ends with ALLUSERS=1 and error 1625), so there it has to be asked for
      with MSIINSTALLPERUSER=1.
    -->
    <SetProperty Id="MSIINSTALLPERUSER" Value="1" Before="FindRelatedProducts" Sequence="ui"
                 Condition="NOT AdminUser AND NOT MSIINSTALLPERUSER AND NOT ALLUSERS=&quot;1&quot;" />

    <!--
      The user interface decides the context before the install runs, and its
      shield, folder and feature tree all read ALLUSERS and INSTALLFOLDER, so
      the default above is carried into them here: no ALLUSERS (the stock
      Install button shows its UAC shield for any ALLUSERS), the radio button
      on "only for me", and the folder named outright because the interface
      resolves ProgramFiles64Folder for a per-machine install.
    -->
    <Property Id="INSTALLSCOPE" Value="machine" Secure="yes" />
    <SetProperty Id="ALLUSERS" Value="" Before="CostInitialize" Sequence="ui"
                 Condition="MSIINSTALLPERUSER=1" />
    <SetProperty Id="INSTALLSCOPE" Value="user" Before="CostInitialize" Sequence="ui"
                 Condition="MSIINSTALLPERUSER=1" />
    <SetProperty Id="INSTALLFOLDER" Value="[LocalAppDataFolder]Programs\remote-docker\" Before="CostInitialize" Sequence="ui"
                 Condition="MSIINSTALLPERUSER=1 AND NOT INSTALLFOLDER" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed. Uninstall it first if you mean to go back." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="remote-docker" />
    </StandardDirectory>

    <!--
      The full path of a docker.exe already installed, or empty. AppSearch
      cannot enumerate PATH, so these are the four directories one realistically
      comes from, each of which is on PATH when it holds one; first match wins.
      Docker Desktop's two are under the real Program Files, named by the
      environment because ProgramFiles64Folder is %LocalAppData%\Programs in a
      per-user install.

      In a 64-bit package `SystemFolder` is SysWOW64 and `System64Folder` is
      System32, the reverse of what the names suggest. Both are searched:
      reading only the first builds, installs and refuses correctly while
      missing the directory anyone means.
    -->
    <Property Id="DOCKERONPATH" Secure="yes">
      <DirectorySearch Id="DS.System64" Path="[System64Folder]">
        <FileSearch Id="FS.System64" Name="docker.exe" />
      </DirectorySearch>
      <DirectorySearch Id="DS.System" Path="[SystemFolder]">
        <FileSearch Id="FS.System" Name="docker.exe" />
      </DirectorySearch>
      <DirectorySearch Id="DS.Desktop" Path="[%ProgramW6432]\Docker\Docker\resources\bin">
        <FileSearch Id="FS.Desktop" Name="docker.exe" />
      </DirectorySearch>
      <DirectorySearch Id="DS.DockerRoot" Path="[%ProgramW6432]\Docker">
        <FileSearch Id="FS.DockerRoot" Name="docker.exe" />
      </DirectorySearch>
    </Property>

    <!-- Set on the command line to install the docker.exe name anyway. -->
    <Property Id="ALLOWDOCKERSHADOW" Secure="yes" />

    <!--
      The feature refuses rather than shadowing another vendor's docker.exe,
      which is the larger version of the promise ADR 0024 makes about a docker
      context we did not create. Only with the Path feature, since a docker.exe
      that is not on PATH shadows nothing. After CostFinalize, where feature
      action states become readable, and in both sequences so a silent install
      and an interactive one refuse alike.
    -->
    <CustomAction Id="RefuseDockerShadow"
                  Error="A docker.exe is already installed at [DOCKERONPATH], and the &quot;docker&quot; name would shadow it.&#xA;fix: leave that feature unselected, or pass ALLOWDOCKERSHADOW=1 to install it anyway." />
    <InstallUISequence>
      <Custom Action="RefuseDockerShadow" After="CostFinalize"
              Condition="NOT Installed AND &amp;DockerName=3 AND &amp;Path=3 AND DOCKERONPATH AND NOT ALLOWDOCKERSHADOW" />
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="RefuseDockerShadow" After="CostFinalize"
              Condition="NOT Installed AND &amp;DockerName=3 AND &amp;Path=3 AND DOCKERONPATH AND NOT ALLOWDOCKERSHADOW" />
    </InstallExecuteSequence>

    <!--
      ONE INSTALL PER USER, AND NO SECOND COPY OVER AN ALL-USERS ONE. FindRelatedProducts sees
      only products in the context of this install, so the other context is
      looked for by what it wrote (component C.Installed; installs from 0.16.x
      and earlier have the Path value instead). Another user's per-user copy is
      in a registry hive this install cannot read, and is not detected.
      MSIINSTALLPERUSER is the context in both sequences, where ALLUSERS is
      still 2 until the user interface is done.
    -->
    <Property Id="MACHINEINSTALL" Secure="yes">
      <RegistrySearch Id="RS.MachineInstalled" Root="HKLM" Key="Software\lhns\remote-docker"
                      Name="Installed" Type="raw" />
    </Property>
    <Property Id="MACHINEINSTALLOLD" Secure="yes">
      <RegistrySearch Id="RS.MachinePath" Root="HKLM" Key="Software\lhns\remote-docker"
                      Name="Path" Type="raw" />
    </Property>
    <Property Id="USERINSTALL" Secure="yes">
      <RegistrySearch Id="RS.UserInstalled" Root="HKCU" Key="Software\lhns\remote-docker"
                      Name="Installed" Type="raw" />
    </Property>

    <!--
      The reverse case warns instead of refusing: an all-users install over the
      installing user's own copy works, and the user's copy stays installed and
      unused, since the system PATH comes first. The warning is a property, so
      it is in the log as a property change. The scope dialog does not show it
      (WiX 5's UI element takes no ControlCondition to follow the radio choice).
      Only the installing user's own hive can be read, so no one else's copy
      is noticed.
    -->
    <SetProperty Id="USEROVERMACHINEWARNING" Before="CostInitialize" Sequence="both"
                 Value="WARNING: remote-docker is also installed for your account alone. That copy stays installed and is no longer used, because the all-users copy comes first on PATH. To remove it, use Settings, Apps, or run msiexec /x with the msi it was installed from, as that user and without administrator rights."
                 Condition="NOT Installed AND NOT MSIINSTALLPERUSER=1 AND USERINSTALL" />
    <CustomAction Id="RefuseUserOverMachine"
                  Error="remote-docker is already installed for all users on this computer.&#xA;fix: use that copy, or ask an administrator to uninstall it first." />
    <CustomAction Id="RefuseHyperVPerUser"
                  Error="The Hyper-V workspace needs an installation for all users, which needs administrator rights, and this is an installation for one user.&#xA;fix: as an administrator, run this installer again with MSIINSTALLPERUSER=&quot;&quot; (or choose &quot;For all users&quot;)." />
    <InstallUISequence>
      <Custom Action="RefuseUserOverMachine" After="CostFinalize"
              Condition="NOT Installed AND MSIINSTALLPERUSER=1 AND (MACHINEINSTALL OR MACHINEINSTALLOLD)" />
      <Custom Action="RefuseHyperVPerUser" After="CostFinalize"
              Condition="ADDLOCAL &gt;&lt; &quot;HyperV&quot; AND MSIINSTALLPERUSER=1" />
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="RefuseUserOverMachine" After="CostFinalize"
              Condition="NOT Installed AND MSIINSTALLPERUSER=1 AND (MACHINEINSTALL OR MACHINEINSTALLOLD)" />
      <Custom Action="RefuseHyperVPerUser" After="CostFinalize"
              Condition="ADDLOCAL &gt;&lt; &quot;HyperV&quot; AND MSIINSTALLPERUSER=1" />
    </InstallExecuteSequence>

    <!--
      THE HYPER-V WORKSPACE (ADR 0048 amendment, ADR 0055). The feature HyperV,
      off by default: a service, a group and one VM, set up by the program
      itself. Every condition below is a transition of that feature, written
      out once as a preprocessor variable further down.
    -->
    <Property Id="WORKSPACENAME" Value="hyperv" Secure="yes" />
    <Property Id="WORKSPACEIMAGE" Value="ghcr.io/lhns/remote-docker-workspace:$(Version)" Secure="yes" />
    <Property Id="WORKSPACEPROXY" Secure="yes" />
    <Property Id="WORKSPACEKEEP" Secure="yes" />

    <!-- The Windows service whose presence means Hyper-V is enabled. Only a test names another. -->
    <Property Id="HYPERVSERVICE" Value="vmms" Secure="yes" />
    <Property Id="HYPERVPRESENT" Secure="yes">
      <RegistrySearch Id="RS.HyperV" Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\[HYPERVSERVICE]"
                      Name="ImagePath" Type="raw" />
    </Property>

    <!--
      What an installed copy of this product recorded (component C.HyperV). In
      an upgrade it is the OLD product's record, read before that product is
      removed, so it is how the new one knows the workspace already exists.
    -->
    <Property Id="HYPERVINSTALLED" Secure="yes">
      <RegistrySearch Id="RS.HyperVInstalled" Root="HKLM" Key="Software\lhns\remote-docker"
                      Name="HyperVWorkspace" Type="raw" />
    </Property>
    <Property Id="REMEMBEREDNAME" Secure="yes">
      <RegistrySearch Id="RS.WorkspaceName" Root="HKLM" Key="Software\lhns\remote-docker"
                      Name="WorkspaceName" Type="raw" />
    </Property>

    <SetProperty Id="WORKSPACEKEEP" Value="[WORKSPACENAME]" Before="CostInitialize" Sequence="both"
                 Condition="NOT HYPERVINSTALLED" />
    <CustomAction Id="KeepRememberedName" Property="WORKSPACEKEEP" Value="[REMEMBEREDNAME]" />
    <InstallUISequence>
      <Custom Action="KeepRememberedName" Before="CostInitialize" Condition="HYPERVINSTALLED" />
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="KeepRememberedName" Before="CostInitialize" Condition="HYPERVINSTALLED" />
    </InstallExecuteSequence>

    <!--
      Without Hyper-V the feature is level 0, and a level 0 feature named in
      ADDLOCAL is skipped without a word, so the request itself is refused.
      No other feature id contains "HyperV".
    -->
    <CustomAction Id="RefuseNoHyperV"
                  Error="Hyper-V is not enabled on this computer, so a Hyper-V workspace cannot be set up.&#xA;fix: in an administrator PowerShell run `Enable-WindowsOptionalFeature -Online -FeatureName Microsoft-Hyper-V -All`, restart, and run this installer again." />
    <!--
      An upgrade carries the workspace over as it stands (MajorUpgrade migrates
      the feature's state) and runs no setup, create or removal, so it can
      neither add the feature nor drop it. After MigrateFeatureStates, which
      runs after CostFinalize and is what selects the feature in an upgrade.
    -->
    <CustomAction Id="RefuseHyperVOnUpgrade"
                  Error="The Hyper-V workspace cannot be added or removed during an upgrade.&#xA;fix: upgrade without changing it, then add or remove it from Settings &gt; Apps &gt; remote-docker &gt; Modify." />
    <InstallUISequence>
      <Custom Action="RefuseNoHyperV" After="CostFinalize"
              Condition="ADDLOCAL &gt;&lt; &quot;HyperV&quot; AND NOT HYPERVPRESENT AND NOT HYPERVINSTALLED" />
      <Custom Action="RefuseHyperVOnUpgrade" After="MigrateFeatureStates"
              Condition="WIX_UPGRADE_DETECTED AND ((&amp;HyperV=3 AND NOT HYPERVINSTALLED) OR (HYPERVINSTALLED AND NOT &amp;HyperV=3))" />
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="RefuseNoHyperV" After="CostFinalize"
              Condition="ADDLOCAL &gt;&lt; &quot;HyperV&quot; AND NOT HYPERVPRESENT AND NOT HYPERVINSTALLED" />
      <Custom Action="RefuseHyperVOnUpgrade" After="MigrateFeatureStates"
              Condition="WIX_UPGRADE_DETECTED AND ((&amp;HyperV=3 AND NOT HYPERVINSTALLED) OR (HYPERVINSTALLED AND NOT &amp;HyperV=3))" />
    </InstallExecuteSequence>

    <!--
      Arriving  the feature is installed by this product now and was not:
                a fresh install, an upgrade (MajorUpgrade migrates the old
                product's feature states, and the new product never had it),
                or Modify adding it. Recreates the service, which the old
                product's removal deleted in an upgrade.
      Added     Arriving, except in an upgrade: the workspace is new, so
                setup and create run, for the user running the installer.
      Leaving   the feature goes from installed to absent: an uninstall or
                Modify removing it, but never the old product's removal
                inside an upgrade.
    -->
    <?define Arriving = '&HyperV=3 AND NOT !HyperV=3' ?>
    <?define Added = '&HyperV=3 AND NOT !HyperV=3 AND NOT WIX_UPGRADE_DETECTED' ?>
    <?define Leaving = '!HyperV=3 AND &HyperV=2 AND NOT UPGRADINGPRODUCTCODE' ?>
    <?define Exe = '"[INSTALLFOLDER]remote-docker.exe"' ?>
    <?define Sc = '"[System64Folder]sc.exe"' ?>

    <!--
      The service is made with sc.exe and not ServiceInstall: that takes the
      service binary from the KEY FILE of its component, which is the exe in
      the always-installed component, and the service must exist only with
      the HyperV feature. Its security descriptor is the stock one for a
      LocalSystem service plus Authenticated Users: start, query, interrogate.
      Nothing else, so a standard user can start it after a reboot and can
      stop, reconfigure or delete nothing.

      Every action runs the program's own hidden commands (client
      machine_service.go) through WixQuietExec, which writes the command's
      output into the log and fails the action on a non-zero exit.
    -->
    <!-- Install, in script order. Each rollback precedes the action it undoes. -->
    <CustomAction Id="R.SvcDelete" DllEntry="WixQuietExec" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="CA.SvcCreate" DllEntry="WixQuietExec" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="CA.SvcSdset" DllEntry="WixQuietExec" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  Execute="deferred" Impersonate="no" Return="check" />
    <CustomAction Id="R.Teardown" DllEntry="WixQuietExec" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="R.StopSvc" DllEntry="WixQuietExec" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  Execute="rollback" Impersonate="no" Return="ignore" />
    <CustomAction Id="CA.Setup" DllEntry="WixQuietExec" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  Execute="deferred" Impersonate="no" Return="check" />
    <!--
      Fails the install when the name is already a workspace or a machine.
      Before R.Rm, so that rollback is only ever scheduled once nothing had
      the name: a rollback action runs only if the script reached it.
    -->
    <CustomAction Id="CA.RefuseExisting" DllEntry="WixQuietExec" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  Execute="deferred" Impersonate="yes" Return="check" />
    <CustomAction Id="R.Rm" DllEntry="WixQuietExec" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  Execute="rollback" Impersonate="yes" Return="ignore" />
    <!-- As the installing user, so the entry, keys and docker context are theirs. -->
    <CustomAction Id="CA.Create" DllEntry="WixQuietExec" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  Execute="deferred" Impersonate="yes" Return="check" />

    <!-- Uninstall. Ignored on failure: an uninstall that cannot finish is worse than a leftover. -->
    <CustomAction Id="CA.Rm" DllEntry="WixQuietExec" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  Execute="deferred" Impersonate="yes" Return="ignore" />
    <CustomAction Id="CA.Teardown" DllEntry="WixQuietExec" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <SetProperty Id="R.SvcDelete" Value="$(Sc) delete remote-docker-machines" Before="R.SvcDelete" Sequence="execute"
                 Condition="$(Arriving)" />
    <SetProperty Id="CA.SvcCreate" Before="CA.SvcCreate" Sequence="execute" Condition="$(Arriving)"
                 Value="$(Sc) create remote-docker-machines binPath= &quot;\&quot;[INSTALLFOLDER]remote-docker.exe\&quot; remote machine service run&quot; start= demand obj= LocalSystem DisplayName= &quot;remote-docker Hyper-V machines&quot;" />
    <SetProperty Id="CA.SvcSdset" Before="CA.SvcSdset" Sequence="execute" Condition="$(Arriving)"
                 Value="$(Sc) sdset remote-docker-machines D:(A;;CCLCSWRPWPDTLOCRRC;;;SY)(A;;CCDCLCSWRPWPDTLOCRSDRCWDWO;;;BA)(A;;CCLCSWLOCRRC;;;IU)(A;;CCLCSWLOCRRC;;;SU)(A;;CCLCSWRPLORC;;;AU)" />
    <SetProperty Id="R.Teardown" Value="$(Exe) remote machine service teardown" Before="R.Teardown" Sequence="execute"
                 Condition="$(Added)" />
    <SetProperty Id="R.StopSvc" Value="&quot;[System64Folder]net.exe&quot; stop remote-docker-machines" Before="R.StopSvc" Sequence="execute"
                 Condition="$(Added)" />
    <SetProperty Id="CA.Setup" Value="$(Exe) remote machine service setup --user-sid [UserSID]" Before="CA.Setup" Sequence="execute"
                 Condition="$(Added)" />
    <SetProperty Id="CA.RefuseExisting" Value="$(Exe) remote machine service refuse-existing &quot;[WORKSPACENAME]&quot;" Before="CA.RefuseExisting" Sequence="execute"
                 Condition="$(Added)" />
    <SetProperty Id="R.Rm" Value="$(Exe) remote rm -f &quot;[WORKSPACENAME]&quot;" Before="R.Rm" Sequence="execute"
                 Condition="$(Added)" />
    <SetProperty Id="PROXYARG" Value="--proxy &quot;[WORKSPACEPROXY]&quot;" Before="CostInitialize" Sequence="execute"
                 Condition="WORKSPACEPROXY" />
    <SetProperty Id="CA.Create" Before="CA.Create" Sequence="execute" Condition="$(Added)"
                 Value="$(Exe) remote machine create &quot;[WORKSPACENAME]&quot; --backend hyperv --image &quot;[WORKSPACEIMAGE]&quot; [PROXYARG]" />
    <SetProperty Id="CA.Rm" Value="$(Exe) remote rm -f &quot;[REMEMBEREDNAME]&quot;" Before="CA.Rm" Sequence="execute"
                 Condition="$(Leaving)" />
    <SetProperty Id="CA.Teardown" Value="$(Exe) remote machine service teardown" Before="CA.Teardown" Sequence="execute"
                 Condition="$(Leaving)" />

    <InstallExecuteSequence>
      <Custom Action="R.SvcDelete" After="InstallFiles" Condition="$(Arriving)" />
      <Custom Action="CA.SvcCreate" After="R.SvcDelete" Condition="$(Arriving)" />
      <Custom Action="CA.SvcSdset" After="CA.SvcCreate" Condition="$(Arriving)" />
      <Custom Action="R.Teardown" After="CA.SvcSdset" Condition="$(Added)" />
      <Custom Action="R.StopSvc" After="R.Teardown" Condition="$(Added)" />
      <Custom Action="CA.Setup" After="R.StopSvc" Condition="$(Added)" />
      <Custom Action="CA.RefuseExisting" After="CA.Setup" Condition="$(Added)" />
      <Custom Action="R.Rm" After="CA.RefuseExisting" Condition="$(Added)" />
      <Custom Action="CA.Create" After="R.Rm" Condition="$(Added)" />

      <Custom Action="CA.Rm" Before="StopServices" Condition="$(Leaving)" />
      <Custom Action="CA.Teardown" After="DeleteServices" Condition="$(Leaving)" />
    </InstallExecuteSequence>

    <UI>
      <ProgressText Action="CA.Create" Message="Creating the Hyper-V workspace; downloading Flatcar may take minutes" />
      <ProgressText Action="CA.SvcCreate" Message="Installing the Hyper-V service" />
      <ProgressText Action="CA.Rm" Message="Removing the Hyper-V workspace" />
    </UI>

    <Feature Id="Main" Title="remote-docker" Level="1" AllowAbsent="no" AllowAdvertise="no"
             Description="The remote-docker command.">
      <Component Id="C.RemoteDockerExe" Directory="INSTALLFOLDER">
        <File Id="F.RemoteDockerExe" Name="remote-docker.exe" Source="$(BinPath)" KeyPath="yes" />
      </Component>

      <!--
        What the other context looks for (see MACHINEINSTALL below). HKMU is
        HKLM in a per-machine install and HKCU in a per-user one, which is the
        whole point of it.
      -->
      <Component Id="C.Installed" Directory="INSTALLFOLDER">
        <RegistryValue Root="HKMU" Key="Software\lhns\remote-docker" Name="Installed"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- A feature of its own, on by default, so it can be left out (ADR 0048). -->
      <Feature Id="Path" Title="Add to PATH" Level="1" AllowAdvertise="no"
               Description="The install folder is appended to PATH, the system one for all users and your own otherwise, so remote-docker runs from any new shell.">
        <!--
          Appended, never prepended: the install directory going first would put
          this binary in front of every tool already on the machine. A user's
          PATH comes after the system one in every process, so a per-user copy
          cannot get in front of a machine-wide tool either. One component per
          context, because the Environment table's System column is fixed.
        -->
        <Component Id="C.Path" Directory="INSTALLFOLDER" Condition="ALLUSERS=1">
          <RegistryValue Root="HKLM" Key="Software\lhns\remote-docker" Name="Path"
                         Type="integer" Value="1" KeyPath="yes" />
          <Environment Id="E.Path" Name="PATH" Value="[INSTALLFOLDER]"
                       Part="last" Action="set" System="yes" Permanent="no" />
        </Component>
        <Component Id="C.UserPath" Directory="INSTALLFOLDER" Condition="NOT ALLUSERS=1">
          <RegistryValue Root="HKCU" Key="Software\lhns\remote-docker" Name="Path"
                         Type="integer" Value="1" KeyPath="yes" />
          <Environment Id="E.UserPath" Name="PATH" Value="[INSTALLFOLDER]"
                       Part="last" Action="set" System="no" Permanent="no" />
        </Component>
      </Feature>

      <!--
        Level 2 against the default INSTALLLEVEL of 1: shown in the feature
        tree, unselected, and selectable; level 0 would hide it entirely. The
        second name is a DuplicateFile, so the payload ships once and the copy
        is made at install and removed at uninstall. Nothing in the Go program
        reads its own name to decide what to be: the Docker CLI is the root
        command (ADR 0024), so the file's name is the whole installation.
      -->
      <Feature Id="DockerName" Title="Also install it as docker.exe" Level="2" AllowAdvertise="no"
               Description="A second copy named docker.exe, so `docker` on this machine is this program. Refused if a docker.exe is already installed.">
        <Component Id="C.DockerAlias" Directory="INSTALLFOLDER">
          <RegistryValue Root="HKMU" Key="Software\lhns\remote-docker" Name="DockerAlias"
                         Type="integer" Value="1" KeyPath="yes" />
          <CopyFile Id="CF.DockerExe" FileId="F.RemoteDockerExe"
                    DestinationDirectory="INSTALLFOLDER" DestinationName="docker.exe" />
        </Component>
      </Feature>

      <!--
        Off by default like DockerName, and level 0 without Hyper-V, unless a
        workspace is already installed: a level 0 feature that is installed
        could no longer be removed, nor migrated by an upgrade. Level 0 in a
        per-user install too, which cannot make a service.
      -->
      <Feature Id="HyperV" Title="Hyper-V workspace" Level="2" AllowAdvertise="no"
               Description="Sets up a Linux machine on this computer, ready to use when setup ends. Removing it deletes the workspace's containers, images and volumes.">
        <Level Value="0" Condition="(NOT HYPERVPRESENT AND NOT HYPERVINSTALLED) OR MSIINSTALLPERUSER=1" />
        <!--
          The remembered flag and name that survive an upgrade, and the
          service's stop and removal (the service itself is made by
          CA.SvcCreate). A string "1" and not a DWORD, which a RegistrySearch
          reads back as "#1".
        -->
        <Component Id="C.HyperV" Directory="INSTALLFOLDER">
          <RegistryValue Root="HKLM" Key="Software\lhns\remote-docker" Name="HyperVWorkspace"
                         Type="string" Value="1" KeyPath="yes" />
          <RegistryValue Root="HKLM" Key="Software\lhns\remote-docker" Name="WorkspaceName"
                         Type="string" Value="[WORKSPACEKEEP]" />
          <ServiceControl Id="SC.Machines" Name="remote-docker-machines" Stop="both" Remove="uninstall" Wait="yes" />
        </Component>
      </Feature>
    </Feature>

    <ui:WixUI Id="WixUI_FeatureTree" />

    <!--
      Who the install is for, after the licence and before the feature tree
      (WixUI_Advanced would replace the whole flow HyperVDlg hooks into). The
      choice is MSIINSTALLPERUSER, with ALLUSERS and the folder following it.
      Built here, never clicked by CI.
    -->
    <UI>
      <Dialog Id="ScopeDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Property="MSIINSTALLPERUSER" Value="1" Order="1" Condition="INSTALLSCOPE=&quot;user&quot;" />
          <Publish Property="ALLUSERS" Value="{}" Order="2" Condition="INSTALLSCOPE=&quot;user&quot;" />
          <Publish Property="INSTALLFOLDER" Value="[LocalAppDataFolder]Programs\remote-docker\" Order="3" Condition="INSTALLSCOPE=&quot;user&quot;" />
          <Publish Property="MSIINSTALLPERUSER" Value="{}" Order="4" Condition="INSTALLSCOPE=&quot;machine&quot;" />
          <Publish Property="ALLUSERS" Value="1" Order="5" Condition="INSTALLSCOPE=&quot;machine&quot;" />
          <Publish Property="INSTALLFOLDER" Value="[ProgramFiles64Folder]remote-docker\" Order="6" Condition="INSTALLSCOPE=&quot;machine&quot;" />
          <Publish Event="NewDialog" Value="CustomizeDlg" Order="7" />
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="LicenseAgreementDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Who is this for?" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="Choose where remote-docker is installed." />
        <Control Id="ScopeGroup" Type="RadioButtonGroup" X="20" Y="60" Width="335" Height="80" Property="INSTALLSCOPE">
          <RadioButtonGroup Property="INSTALLSCOPE">
            <RadioButton Value="user" X="0" Y="0" Width="330" Height="18" Text="Only for me (no administrator rights needed)" />
            <RadioButton Value="machine" X="0" Y="30" Width="330" Height="18" Text="For all users of this computer (needs administrator rights)" />
          </RadioButtonGroup>
        </Control>
        <Control Id="Note" Type="Text" X="20" Y="150" Width="335" Height="40" NoPrefix="yes"
                 Text="The Hyper-V workspace is only available for all users." />
      </Dialog>

      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="ScopeDlg" Order="3"
               Condition="LicenseAccepted = &quot;1&quot; AND NOT Installed" />
      <Publish Dialog="CustomizeDlg" Control="Back" Event="NewDialog" Value="ScopeDlg" Order="3"
               Condition="NOT Installed" />
    </UI>

    <!--
      One dialog after the feature tree, shown when this session adds the
      HyperV feature (Added, above). The stock sequence already sends CustomizeDlg
      Next to VerifyReadyDlg at Order 1; the later NewDialog at Order 2 wins,
      which is how WixUI is customised without copying it. Built here, never
      clicked by CI.
    -->
    <UI>
      <Dialog Id="HyperVDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Hyper-V workspace" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="A Linux machine on this computer, ready to use when setup ends." />

        <Control Id="NameLabel" Type="Text" X="20" Y="62" Width="90" Height="15" NoPrefix="yes" Text="Workspace name" />
        <Control Id="Name" Type="Edit" X="112" Y="60" Width="140" Height="18" Property="WORKSPACENAME" Text="{80}" />
        <Control Id="ImageLabel" Type="Text" X="20" Y="86" Width="90" Height="15" NoPrefix="yes" Text="Workspace image" />
        <Control Id="Image" Type="Edit" X="112" Y="84" Width="243" Height="18" Property="WORKSPACEIMAGE" Text="{250}" />
        <Control Id="ProxyLabel" Type="Text" X="20" Y="110" Width="90" Height="15" NoPrefix="yes" Text="Proxy (optional)" />
        <Control Id="Proxy" Type="Edit" X="112" Y="108" Width="243" Height="18" Property="WORKSPACEPROXY" Text="{250}" />
        <Control Id="Warning" Type="Text" X="20" Y="190" Width="335" Height="30" NoPrefix="yes"
                 Text="Uninstalling deletes this workspace's containers, images and volumes." />
      </Dialog>

      <Publish Dialog="CustomizeDlg" Control="Next" Event="NewDialog" Value="HyperVDlg" Order="2"
               Condition="$(Added)" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="HyperVDlg" Order="4"
               Condition="$(Added)" />
      <Publish Dialog="HyperVDlg" Control="Back" Event="NewDialog" Value="CustomizeDlg" />
      <Publish Dialog="HyperVDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" />
    </UI>
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />
  </Package>
</Wix>
