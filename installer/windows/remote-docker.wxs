<?xml version="1.0" encoding="utf-8"?>
<!--
  The Windows installer. Built on Linux by WiX v5 in the release workflow; see
  build.sh beside this file and docs/adr/0048-a-windows-installer.md.

  Two preprocessor variables, both required: BinPath (the remote-docker.exe to
  package) and Version (major.minor.build, validated by build.sh).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!--
    THE UpgradeCode MUST NEVER CHANGE. It is the only thing that relates one
    release's MSI to the next: change it and every future upgrade silently
    stops being an upgrade, leaving two installs side by side, two entries in
    Programs and Features, and two copies on PATH.
  -->
  <Package Name="remote-docker"
           Manufacturer="lhns"
           Version="$(Version)"
           UpgradeCode="6FDE5FD9-D1A3-4094-B8EC-2193CA79C91F"
           Scope="perMachine"
           Language="1033"
           Compressed="yes"
           InstallerVersion="500">

    <SummaryInformation Description="Docker from a machine that cannot have Docker installed" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed. Uninstall it first if you mean to go back." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="remote-docker" />
    </StandardDirectory>

    <!--
      Whether a docker.exe already exists in a directory that is on the system
      PATH. MSI's AppSearch cannot enumerate PATH, so this is the set of
      directories a docker.exe realistically comes from, each of which is on
      PATH when it holds one: System32, and the two places Docker Desktop puts
      its CLI. First match wins and its full path goes in the property, which
      the refusal message names.
    -->
    <Property Id="DOCKERONPATH" Secure="yes">
      <!--
        BOTH system directories, and neither is optional. In a 64-bit package
        `SystemFolder` is SysWOW64 and `System64Folder` is System32, which is
        the reverse of what the names suggest; both are on PATH on a 64-bit
        Windows. Searching only `SystemFolder` looks right, builds, installs,
        and misses every docker.exe in the directory people mean.
      -->
      <DirectorySearch Id="DS.System64" Path="[System64Folder]">
        <FileSearch Id="FS.System64" Name="docker.exe" />
      </DirectorySearch>
      <DirectorySearch Id="DS.System" Path="[SystemFolder]">
        <FileSearch Id="FS.System" Name="docker.exe" />
      </DirectorySearch>
      <DirectorySearch Id="DS.Desktop" Path="[ProgramFiles64Folder]Docker\Docker\resources\bin">
        <FileSearch Id="FS.Desktop" Name="docker.exe" />
      </DirectorySearch>
      <DirectorySearch Id="DS.DockerRoot" Path="[ProgramFiles64Folder]Docker">
        <FileSearch Id="FS.DockerRoot" Name="docker.exe" />
      </DirectorySearch>
    </Property>

    <!-- Set on the command line to install the docker.exe name anyway. -->
    <Property Id="ALLOWDOCKERSHADOW" Secure="yes" />

    <!--
      Installing our docker.exe ahead of somebody else's is a large intrusion
      into another vendor's tool: the same promise ADR 0024 makes about never
      touching a docker context we did not create. So the feature refuses
      rather than shadowing, and names what it found.
    -->
    <CustomAction Id="RefuseDockerShadow"
                  Error="A docker.exe is already installed at [DOCKERONPATH], and the &quot;docker&quot; name would shadow it.&#xA;fix: leave that feature unselected, or pass ALLOWDOCKERSHADOW=1 to install it anyway." />

    <!--
      After CostFinalize, which is where feature action states become readable.
      In both sequences so a silent install and an interactive one refuse alike.
    -->
    <InstallUISequence>
      <Custom Action="RefuseDockerShadow" After="CostFinalize"
              Condition="NOT Installed AND &amp;DockerName=3 AND DOCKERONPATH AND NOT ALLOWDOCKERSHADOW" />
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="RefuseDockerShadow" After="CostFinalize"
              Condition="NOT Installed AND &amp;DockerName=3 AND DOCKERONPATH AND NOT ALLOWDOCKERSHADOW" />
    </InstallExecuteSequence>

    <ComponentGroup Id="Core" Directory="INSTALLFOLDER">
      <Component Id="C.RemoteDockerExe">
        <File Id="F.RemoteDockerExe" Name="remote-docker.exe" Source="$(BinPath)" KeyPath="yes" />
      </Component>

      <!--
        Appended, never prepended: the install directory going first would put
        this binary in front of every tool already on the machine.
      -->
      <Component Id="C.Path">
        <RegistryValue Root="HKLM" Key="Software\lhns\remote-docker" Name="Path"
                       Type="integer" Value="1" KeyPath="yes" />
        <Environment Id="E.Path" Name="PATH" Value="[INSTALLFOLDER]"
                     Part="last" Action="set" System="yes" Permanent="no" />
      </Component>
    </ComponentGroup>

    <!--
      The second name is a DuplicateFile, so the ~70MB payload ships once and
      the copy is made at install and removed at uninstall. Nothing in the Go
      program reads its own name to decide what to be: the Docker CLI is the
      root command (ADR 0024), so the file's name is the whole installation.
    -->
    <ComponentGroup Id="DockerAlias" Directory="INSTALLFOLDER">
      <Component Id="C.DockerAlias">
        <RegistryValue Root="HKLM" Key="Software\lhns\remote-docker" Name="DockerAlias"
                       Type="integer" Value="1" KeyPath="yes" />
        <CopyFile Id="CF.DockerExe" FileId="F.RemoteDockerExe"
                  DestinationDirectory="INSTALLFOLDER" DestinationName="docker.exe" />
      </Component>
    </ComponentGroup>

    <!--
      Level 2 against the default INSTALLLEVEL of 1: shown in the feature tree,
      unselected, and selectable. Level 0 would hide it from the UI entirely.
    -->
    <Feature Id="Main" Title="remote-docker" Level="1" AllowAbsent="no" AllowAdvertise="no"
             Description="The remote-docker command, added to the system PATH.">
      <ComponentGroupRef Id="Core" />

      <Feature Id="DockerName" Title="Also install it as docker.exe" Level="2" AllowAdvertise="no"
               Description="A second copy named docker.exe, so `docker` on this machine is this program. Refused if a docker.exe is already installed.">
        <ComponentGroupRef Id="DockerAlias" />
      </Feature>
    </Feature>

    <ui:WixUI Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />
  </Package>
</Wix>
