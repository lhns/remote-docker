// Local development across the six modules.
//
// Not what CI or the image build use -- each of those builds one module, with
// the `replace` directives in its go.mod doing the resolving -- so a mistake
// here cannot hide a mistake there.
go 1.26.3

use (
	./core
	./agent
	./core-agent
	./core-client
	./client
	./dircache
)
