# The workspace agent's settings, as the image sets them, for a VM.
#
# Copy to /etc/remote-docker/env. Everything here is a default the agent would
# pick anyway EXCEPT the first one, which is the whole difference between a VM
# and the container.

# The container starts and supervises its own dockerd. A VM already has one,
# started by systemd, and a second would fight it for /var/run/docker.sock.
WORKSPACE_ENABLE_DIND=false

# A dockerd per account, in a privileged container on this machine's docker
# (ADR 0019). Set false to share this machine's own daemon instead -- which on
# a VM means enrolled accounts also see whatever else the machine runs, and
# means this machine needs an NFS client of its own. See the README.
WORKSPACE_PER_USER_DIND=true

# Where the enrolment keys and the agent's own state live. One <name>.pub per
# account in the keys directory; the filename is the account name.
WORKSPACE_STATE_DIR=/etc/workspace
WORKSPACE_KEYS_DIR=/etc/workspace/authorized_keys.d
WORKSPACE_HOSTKEY_DIR=/etc/workspace/host_keys

# reverse-tunnel port = PORT_BASE + (uid - UID_BASE), so every account gets a
# private, stable port with no coordination. Move UID_BASE if this machine
# already has users in the 10000 range; the agent refuses to adopt a uid that
# belongs to somebody else rather than guessing.
WORKSPACE_UID_BASE=10000
WORKSPACE_PORT_BASE=30000

WORKSPACE_SHELL=/bin/bash
WORKSPACE_KEY_POLL_INTERVAL=60
