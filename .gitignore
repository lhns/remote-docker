# test image build artifact
test/watchdir

# go build output.
#
# Every module root is listed, because `go build ./cmd/remote-docker` writes
# the binary into the directory it runs in, and a 95MB artifact in client/ was
# once one `git add -A` away from being committed.
#
# NOT the bare name `remote-docker`: an unanchored pattern matches directories
# too, so it swallowed client/cmd/remote-docker/ and every new source file in
# it, silently. The fix for one silent mistake made a worse one.
/dist/
/remote-docker
/remote-docker.exe
/remote-dockerd
/remote-dockerd.exe
/client/remote-docker
/client/remote-docker.exe
/client/remote-dockerd
/client/remote-dockerd.exe
/agent/remote-docker
/agent/remote-docker.exe
/agent/remote-dockerd
/agent/remote-dockerd.exe
*.test
*.test.exe
coverage.out

# local deployment state -- host keys, uidmap, enrolled public keys
deploy/state/
deploy/authorized_keys.d/

# go.work.sum is a local artefact of the development workspace. CI and the
# image build resolve through each module go.mod instead, so committing it
# would be a file nothing verifies and everything conflicts on.
go.work.sum

# Generated by scripts/third-party-notices.sh at build time.
THIRD-PARTY-NOTICES.md

# Worktrees an agent checked out here. Live git repositories, and committing
# one adds a gitlink nothing can resolve.
.claude/worktrees/
