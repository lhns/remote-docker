# test image build artifact
test/watchdir

# go build output. Not anchored to the root: `go build ./cmd/remote-docker`
# writes the binary into whatever directory it runs in, and the natural one to
# run it from is client/, where a 95MB artifact was one `git add -A` from
# being committed.
/dist/
remote-docker
remote-docker.exe
remote-dockerd
remote-dockerd.exe
*.test
*.test.exe
coverage.out

# local deployment state -- host keys, uidmap, enrolled public keys
deploy/state/
deploy/authorized_keys.d/

# go.work.sum is a local artefact of the development workspace. CI and the
# image build resolve through each module go.mod instead, so committing it
# would be a file nothing verifies and everything conflicts on.
go.work.sum
