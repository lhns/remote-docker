// The pre-split genproto monolith still contains googleapis/api/annotations,
// which the split module google.golang.org/genproto/googleapis/api also
// provides -- so having both in the graph is an ambiguous import. Requiring
// the newer monolith is not enough, because `go mod tidy` drops a require
// nothing imports directly and MVS then picks this one back up from a
// transitive dependency. Excluding it forces a post-split version.
exclude google.golang.org/genproto v0.0.0-20230306155012-7f2fa6fef1f4
