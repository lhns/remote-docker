#!/bin/sh
# Print this user's workspace parameters as KEY=VALUE lines.
# The client calls this over ssh to learn which reverse-tunnel port to use.
set -eu

# shellcheck disable=SC1091
[ -f /etc/workspace/config ] && . /etc/workspace/config

: "${WORKSPACE_UID_BASE:=10000}"
: "${WORKSPACE_PORT_BASE:=30000}"

user=${SUDO_USER:-$(id -un)}
uid=$(id -u "$user")
gid=$(id -g "$user")
home=$(getent passwd "$user" | cut -d: -f6)
port=$((WORKSPACE_PORT_BASE + uid - WORKSPACE_UID_BASE))

mounted=false
mountpoint -q "$home/workspace" 2>/dev/null && mounted=true

echo "WORKSPACE_USER=$user"
echo "WORKSPACE_UID=$uid"
echo "WORKSPACE_GID=$gid"
echo "WORKSPACE_NFS_PORT=$port"
echo "WORKSPACE_MOUNTPOINT=$home/workspace"
echo "WORKSPACE_MOUNTED=$mounted"
echo "WORKSPACE_DOCKER=$(docker version --format '{{.Server.Version}}' 2>/dev/null || echo unavailable)"
