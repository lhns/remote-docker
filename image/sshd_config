Port 2222
AddressFamily any
ListenAddress 0.0.0.0

HostKey /etc/workspace/host_keys/ssh_host_ed25519_key
HostKey /etc/workspace/host_keys/ssh_host_rsa_key

# Public keys only. Accounts are provisioned by key-watcher from
# /etc/workspace/authorized_keys.d -- there are no passwords anywhere.
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
UsePAM no
AuthenticationMethods publickey
AuthorizedKeysFile .ssh/authorized_keys

# Remote forwarding carries the NFS share from the client into the container.
# Local forwarding lets the client reach services running in dev containers
# (e.g. ssh -L 8080:172.17.0.2:8080). Both are needed; neither is exposed
# beyond loopback because GatewayPorts stays off.
AllowTcpForwarding yes
GatewayPorts no
PermitTunnel no
X11Forwarding no
AllowAgentForwarding no

# Detect dead clients quickly so a dropped tunnel does not leave a stale
# NFS mount wedging containers.
ClientAliveInterval 15
ClientAliveCountMax 4
TCPKeepAlive yes

LoginGraceTime 30
MaxAuthTries 3
PrintMotd no
Subsystem sftp internal-sftp
